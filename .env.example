# Copier en .env (ou renseigner directement dans Portainer > Stacks > Environment variables)

IMMICH_SERVER=http://192.168.1.205:2283
IMMICH_API_KEY=colle_ta_cle_api_ici

# Chemin HOST (sur la VM Docker 192.168.1.205) vers les données persistantes du conteneur
IMMICH_SCRIPTS_DATA=/home/mathieu/immich-scripts-data

# Chemin HOST vers la bibliothèque Immich (UPLOAD_LOCATION de ta stack Immich)
# Doit être monté en lecture-écriture pour la correction d'orientation in-place
IMMICH_LIBRARY_PATH=/mnt/raid/immich-app/upload

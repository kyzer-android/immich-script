# Copier en .env (ou renseigner directement dans Portainer > Stacks > Environment variables)

IMMICH_SERVER=http://192.168.1.205:2283
IMMICH_API_KEY=colle_ta_cle_api_ici

# Port hôte du dashboard (change-le si 8080 est déjà utilisé sur ta VM)
DASHBOARD_PORT=8080

# Limite mémoire dure du conteneur (protège le host en cas de fuite mémoire)
MEM_LIMIT=2g

# Limite CPU du conteneur, en nombre de cœurs équivalents (ex: 2.0 = 2 cœurs max)
# Protège tes autres services (Immich, Jellyfin...) sur la même VM d'un run trop gourmand
CPU_LIMIT=2.0

# Chemin HOST (sur la VM Docker 192.168.1.205) vers les données persistantes du conteneur
# (config, state, backups, logs — PAS les photos elles-mêmes)
IMMICH_SCRIPTS_DATA=/home/mathieu/immich-scripts-data

# Chemin HOST sur le RAID (via le mount NFS existant sur la VM Docker) pour le dossier
# BLOOMIN8 — c'est ce chemin, une fois traduit côté host Proxmox, qu'il faudra exporter
# en NFS vers HAOS (cf. README)
BLOOMIN8_SHARE_PATH=/mnt/raid_usb/docker-data/bloomin8-share

# Chemin HOST vers la bibliothèque Immich (UPLOAD_LOCATION de ta stack Immich)
# Doit être monté en lecture-écriture pour la correction d'orientation in-place
IMMICH_LIBRARY_PATH=/mnt/raid/immich-app/upload
